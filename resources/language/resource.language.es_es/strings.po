msgstr "rclone serve http terminó al iniciar.\n{logs}"

msgctxt "#30822"
msgid "rclone serve http did not pass local verification within {seconds}s.\n{logs}"
msgstr "rclone serve http no superó la verificación local en {seconds}s.\n{logs}"
