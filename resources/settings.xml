<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <category label="Conexión">
        <setting id="conf_path" label="Ruta de rclone.conf" type="file" default="" />
        <setting id="remote_name" label="Remote preferido (aparece primero)" type="text" default="" />
    </category>

    <category label="Binario rclone local">
        <setting id="rclone_path" label="Ruta directa del binario rclone (mínimo 1.75.0)" type="file" default="" />
        <setting id="rclone_install_dir" label="Carpeta interna ejecutable (opcional)" type="folder" default="" />
        <setting id="rclone_arch" label="Arquitectura: auto, armv7a, armv8a, x86 o x64" type="text" default="auto" />
        <setting id="serve_port_start" label="Puerto inicial para rclone serve" type="number" default="28980" />
        <setting id="serve_start_timeout" label="Espera de arranque del servidor (segundos)" type="number" default="30" />
        <setting id="server_idle_minutes" label="Detener servidor después de inactividad (minutos)" type="number" default="20" />
        <setting id="rclone_serve_extra_args" label="Opciones avanzadas seguras (lista permitida)" type="text" default="" />
    </category>

    <category label="Reproducción y espacio">
        <setting id="vfs_cache_mode" label="Modo VFS: off, minimal, writes o full" type="text" default="off" />
        <setting id="vfs_cache_max_size_mb" label="Límite máximo de caché VFS (MB)" type="number" default="128" />
        <setting id="buffer_size_mb" label="Búfer en memoria por reproducción (MB)" type="number" default="8" />
        <setting id="read_chunk_size_mb" label="Bloque inicial de lectura (MB)" type="number" default="16" />
        <setting id="read_chunk_limit_mb" label="Límite de bloque de lectura (MB)" type="number" default="128" />
        <setting id="read_chunk_streams" label="Flujos de lectura paralelos (0 = lectura adaptativa)" type="number" default="0" />
    </category>

    <category label="Navegación">
        <setting id="list_cache_minutes" label="Caché de carpetas (minutos)" type="number" default="30" />
        <setting id="list_timeout" label="Tiempo máximo de listado (segundos)" type="number" default="120" />
        <setting id="skip_modtime" label="Omitir fecha al navegar para acelerar" type="bool" default="true" />
    </category>

    <category label="Biblioteca STRM">
        <setting id="library_root" label="Carpeta local para bibliotecas STRM" type="folder" default="" />
        <setting id="strm_keep_extension" label="Conservar extensión original dentro del nombre .strm" type="bool" default="false" />
        <setting id="library_delete_missing" label="Eliminar STRM cuando el archivo remoto desaparezca" type="bool" default="true" />
        <setting id="library_fast_list" label="Usar --fast-list (menos llamadas API, mayor memoria)" type="bool" default="false" />
        <setting id="library_allow_empty_remote" label="Permitir que un escaneo remoto vacío elimine STRM existentes" type="bool" default="false" />
        <setting id="library_scan_timeout" label="Tiempo máximo de escaneo recursivo (segundos)" type="number" default="900" />
        <setting id="storage_reserve_mb" label="Espacio libre mínimo reservado para Kodi (MB)" type="number" default="128" />
        <setting id="auto_update_kodi_library" label="Solicitar actualización de biblioteca Kodi después de cambios" type="bool" default="true" />
        <setting id="new_content_days" label="Días que se muestran como contenido nuevo" type="number" default="30" />
    </category>

    <category label="Sincronización automática">
        <setting id="auto_sync_enabled" label="Revisar bibliotecas automáticamente" type="bool" default="false" />
        <setting id="sync_during_playback" label="Permitir escaneo remoto durante reproducción (bajo impacto)" type="bool" default="false" />
        <setting id="smart_change_detection" label="Detección inteligente de cambios (ChangeNotify cuando esté disponible)" type="bool" default="true" />
        <setting id="change_poll_minutes" label="Intervalo ChangeNotify (minutos)" type="number" default="5" />
        <setting id="change_debounce_seconds" label="Agrupar cambios antes de sincronizar (segundos)" type="number" default="90" />
        <setting id="change_watch_max_processes" label="Máximo de monitores ChangeNotify simultáneos" type="number" default="2" />
        <setting id="safety_full_scan_hours" label="Escaneo completo de seguridad (horas)" type="number" default="24" />
        <setting id="auto_sync_interval_minutes" label="Intervalo de revisión (mínimo 30 minutos)" type="number" default="180" />
    </category>
</settings>
